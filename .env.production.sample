APP_ENV=production
BASE_URL=http://your-domain.com

# Database (SQLite by default; PostgreSQL example below)
# DATABASE_URL=sqlite:///data/writ.db
DATABASE_URL=postgresql+psycopg2://dbuser:dbpassword@db:5432/dbname
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ActivityPub federation (required)
# DOMAIN=your-domain.com       # optional, parsed from BASE_URL
# SCHEME=https                  # optional, parsed from BASE_URL

# Crypto (REQUIRED — no default)
SECRET_KEY=change-me-to-a-random-secret-key

# First user auto-admin password (optional; if set, first register gets admin)
INITIAL_OWNER_PASSWORD=

# SNS
# MAX_POST_LENGTH=500

# SMTP (for email notifications/verification)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.com

# Object Storage (S3-compatible; unset = local storage)
#S3_ENABLED=true
#S3_ENDPOINT=https://s3.example.com
#S3_REGION=auto
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_BUCKET=files.example.com
#S3_PUBLIC_URL=https://files.example.com

# SSRF allow
# SSRF_ALLOWED_DOMAINS=
